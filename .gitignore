__pycache__/
*.pyc

# runtime queue for reports that could not reach the workbook yet
.task_reports_pending.jsonl

# task board side files: the quarantined copy of an unreadable board, and the
# in-flight temp file an atomic save writes through
task_board.json.bad
task_board.json.tmp

# task files: removed ones wait in the trash so Undo can bring them back, and
# an upload is written to a .part file before it is moved into place
task_files/.trash/
task_files/**/.*.part

# the packaged Windows app: the build venv, PyInstaller's scratch folders,
# the built exe, and the path baked into it at build time
.winenv/
build/
TaskReporter.exe
windows/project_home.txt

# where the windowed app writes what used to go to the terminal, and how a
# second launch finds the window that is already open
.task_reporter_app.log
.task_reporter_app.log.1
.task_reporter_app.lock

# installer output
install.log
install.log.old
Start Task Reporter.bat
.venv/

# Windows "downloaded from the internet" markers
*:Zone.Identifier
