#!/usr/bin/env bash
# Launch the Task Reporter from anywhere on the Linux side.
#
#   ./task-report            browser UI + terminal console together
#   ./task-report --cli      terminal console only
#   ./task-report --gui      browser UI only
#   ./task-report -m "text"  file one report and exit
#   ./task-report --qt       the old PySide6 window instead of the browser UI
#   ./task-report --doctor   check both UIs end to end
#
# Override the interpreter with TASK_REPORT_PYTHON=/path/to/python if needed.
set -u

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PY="${TASK_REPORT_PYTHON:-}"
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
    PY=""
    for candidate in \
        "$DIR/.venv/bin/python" \
        /root/miniconda3/envs/movs/bin/python \
        "$HOME/miniconda3/envs/movs/bin/python" \
        "$(command -v python3 2>/dev/null)" \
        "$(command -v python 2>/dev/null)"
    do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            PY="$candidate"
            break
        fi
    done
fi

if [ -z "$PY" ]; then
    echo "Task Reporter: no usable Python interpreter found." >&2
    echo "" >&2
    echo "  Run the installer first - it makes one in .venv/ and explains" >&2
    echo "  anything that goes wrong:" >&2
    echo "      ./install.sh" >&2
    echo "" >&2
    echo "  Or point at your own interpreter:  TASK_REPORT_PYTHON=/path/to/python" >&2
    exit 1
fi

if ! "$PY" -c 'import openpyxl' >/dev/null 2>&1; then
    echo "Task Reporter: this Python has no openpyxl, so the workbook cannot be" >&2
    echo "written. Run ./install.sh - it sets up a .venv/ with everything." >&2
    exit 1
fi

exec "$PY" "$DIR/task-report-maker.py" "$@"
